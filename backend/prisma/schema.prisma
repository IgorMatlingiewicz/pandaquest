// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  xpTotal      Int      @default(0)
  level        Int      @default(1)
  timezone     String   @default("Europe/Warsaw")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories Category[]
  tasks Task[]
  xpEvents XpEvent[]
  @@map("users")
}

enum TaskType {
  DAILY
  WEEKLY
  LIFE
  SIDE_QUEST
}

enum CompletionMode {
  BOOLEAN
  PROGRESS
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum CategoryColor {
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  PURPLE
  PINK
  GRAY
}

model Category {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  icon        String?
  color       CategoryColor @default(GRAY)
  cycleType   TaskType?
  isDeletable Boolean       @default(true)
  isTemplate  Boolean       @default(false)
  order       Int           @default(0)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("categories")
}

model Task {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  parentTaskId    String?
  parentTask      Task?          @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks        Task[]         @relation("Subtasks")
  title           String
  type            TaskType       @default(SIDE_QUEST)
  completionMode  CompletionMode @default(BOOLEAN)
  progressCurrent Int?
  progressTarget  Int?
  deadline        DateTime?
  status          TaskStatus     @default(ACTIVE)
  visibility      Visibility     @default(PRIVATE)
  order           Int            @default(0)
  completions     TaskCompletion[]
  xpEvents        XpEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("tasks")
}

// Per-period state of a DAILY/WEEKLY task. The Task row is the template;
// a missing row for the current period means "not started yet".
model TaskCompletion {
  id               String    @id @default(uuid())
  taskId           String
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  periodKey        String
  progressCurrent  Int?
  // Set while the task is completed in this period, cleared on un-complete.
  completedAt      DateTime?
  // First completion in this period. Set once, never cleared.
  firstCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([taskId, periodKey])
  @@map("task_completions")
}

// One row per XP award. The unique key is the database-level guard against
// awarding the same task twice in one period.
model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null once the task is deleted: the XP stays earned.
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // 'yyyy-MM-dd' (DAILY), 'yyyy-Www' (WEEKLY) or 'LIFETIME' (LIFE, SIDE_QUEST).
  periodKey  String
  baseXp     Int
  multiplier Float
  amount     Int
  createdAt  DateTime @default(now())

  @@unique([taskId, periodKey])
  @@index([userId, createdAt])
  @@map("xp_events")
}