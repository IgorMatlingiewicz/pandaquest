// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  xpTotal      Int      @default(0)
  level        Int      @default(1)
  timezone     String   @default("Europe/Warsaw")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories Category[]
  tasks Task[]
  xpEvents XpEvent[]
  badges UserBadge[]
  completedPeriods CompletedPeriod[]
  @@map("users")
}

enum TaskType {
  DAILY
  WEEKLY
  LIFE
  SIDE_QUEST
}

enum CompletionMode {
  BOOLEAN
  PROGRESS
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum CategoryColor {
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  PURPLE
  PINK
  GRAY
}

model Category {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  icon        String?
  color       CategoryColor @default(GRAY)
  cycleType   TaskType?
  isDeletable Boolean       @default(true)
  isTemplate  Boolean       @default(false)
  order       Int           @default(0)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("categories")
}

model Task {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  parentTaskId    String?
  parentTask      Task?          @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks        Task[]         @relation("Subtasks")
  title           String
  type            TaskType       @default(SIDE_QUEST)
  completionMode  CompletionMode @default(BOOLEAN)
  progressCurrent Int?
  progressTarget  Int?
  deadline        DateTime?
  status          TaskStatus     @default(ACTIVE)
  visibility      Visibility     @default(PRIVATE)
  order           Int            @default(0)
  completions     TaskCompletion[]
  xpEvents        XpEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("tasks")
}

// Per-period state of a DAILY/WEEKLY task. The Task row is the template;
// a missing row for the current period means "not started yet".
model TaskCompletion {
  id               String    @id @default(uuid())
  taskId           String
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  periodKey        String
  progressCurrent  Int?
  // Set while the task is completed in this period, cleared on un-complete.
  completedAt      DateTime?
  // First completion in this period. Set once, never cleared.
  firstCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([taskId, periodKey])
  @@map("task_completions")
}

enum XpSource {
  TASK
  BADGE
}

// One row per XP award. For TASK rows the unique key is the database-level
// guard against awarding the same task twice in one period. BADGE rows have
// a null taskId, and Postgres treats NULLs as distinct in a unique index, so
// this key never rejects them: the guard for badges is the unique key on
// UserBadge, inserted in the same transaction before the XP is written.
model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The default keeps the rows written before badges existed valid.
  source     XpSource @default(TASK)
  // Null once the task is deleted (the XP stays earned) and for BADGE rows.
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // 'yyyy-MM-dd' (DAILY), 'yyyy-Www' (WEEKLY) or 'LIFETIME' (LIFE,
  // SIDE_QUEST and badges).
  periodKey  String
  baseXp     Int
  multiplier Float
  amount     Int
  createdAt  DateTime @default(now())

  @@unique([taskId, periodKey])
  @@index([userId, createdAt])
  @@map("xp_events")
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

// A badge tier the user has earned. Rows are only ever added: an earned
// badge stays even if the tasks or categories behind it are deleted.
model UserBadge {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Key of a definition in badges.config.ts. A plain string, not an enum,
  // so the config stays the single source of truth for the catalog.
  badgeKey String
  tier     BadgeTier
  earnedAt DateTime  @default(now())

  // Each tier is earned (and its XP awarded) at most once per account.
  // Also serves "all badges of a user" through its leading userId column.
  @@unique([userId, badgeKey, tier])
  @@map("user_badges")
}

// Periods a cycle's tasks can be completed in; a subset of TaskType.
enum CycleType {
  DAILY
  WEEKLY
}

// A period in which every due top-level task of the cycle was completed,
// recorded at the moment the last one was checked. Never removed: unchecking
// or deleting tasks later does not rewrite history.
model CompletedPeriod {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleType   CycleType
  // Same format as TaskCompletion.periodKey. Zero-padded, so sorting the
  // strings sorts the periods in time order.
  periodKey   String
  completedAt DateTime  @default(now())

  // One row per period. The same index answers the streak query
  // (userId, cycleType = ? ORDER BY periodKey DESC LIMIT n) without a sort.
  @@unique([userId, cycleType, periodKey])
  @@map("completed_periods")
}