// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String
  xpTotal      Int      @default(0)
  level        Int      @default(1)
  timezone     String   @default("Europe/Warsaw")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories Category[]
  tasks Task[]
  xpEvents XpEvent[]
  badges UserBadge[]
  completedPeriods CompletedPeriod[]
  streakGoals StreakGoal[]
  favoriteBadges FavoriteBadge[]
  @@map("users")
}

enum TaskType {
  DAILY
  WEEKLY
  LIFE
  SIDE_QUEST
}

enum CompletionMode {
  BOOLEAN
  PROGRESS
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum CategoryColor {
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  PURPLE
  PINK
  GRAY
}

model Category {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  icon        String?
  color       CategoryColor @default(GRAY)
  cycleType   TaskType?
  isDeletable Boolean       @default(true)
  isTemplate  Boolean       @default(false)
  order       Int           @default(0)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("categories")
}

model Task {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  parentTaskId    String?
  parentTask      Task?          @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks        Task[]         @relation("Subtasks")
  title           String
  type            TaskType       @default(SIDE_QUEST)
  completionMode  CompletionMode @default(BOOLEAN)
  progressCurrent Int?
  progressTarget  Int?
  deadline        DateTime?
  status          TaskStatus     @default(ACTIVE)
  visibility      Visibility     @default(PRIVATE)
  order           Int            @default(0)
  completions     TaskCompletion[]
  xpEvents        XpEvent[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("tasks")
}

// Per-period state of a DAILY/WEEKLY task. The Task row is the template;
// a missing row for the current period means "not started yet".
model TaskCompletion {
  id               String    @id @default(uuid())
  taskId           String
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  periodKey        String
  progressCurrent  Int?
  // Set while the task is completed in this period, cleared on un-complete.
  completedAt      DateTime?
  // First completion in this period. Set once, never cleared.
  firstCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([taskId, periodKey])
  @@map("task_completions")
}

enum XpSource {
  TASK
  BADGE
  STREAK_GOAL
}

// One row per XP award. For TASK rows the unique key is the database-level
// guard against awarding the same task twice in one period. BADGE and
// STREAK_GOAL rows have a null taskId, and Postgres treats NULLs as distinct
// in a unique index, so this key never rejects them. Their guards are the
// unique key on UserBadge and the daysRewarded mark on StreakGoal, both
// changed in the same transaction before the XP is written.
model XpEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The default keeps the rows written before badges existed valid.
  source     XpSource @default(TASK)
  // Null once the task is deleted (the XP stays earned) and for rows that
  // do not come from a task.
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // 'yyyy-MM-dd' (DAILY), 'yyyy-Www' (WEEKLY) or 'LIFETIME' (LIFE,
  // SIDE_QUEST, badges and streak goals).
  periodKey  String
  baseXp     Int
  multiplier Float
  amount     Int
  createdAt  DateTime @default(now())

  @@unique([taskId, periodKey])
  @@index([userId, createdAt])
  @@map("xp_events")
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

// A badge tier the user has earned. Rows are only ever added: an earned
// badge stays even if the tasks or categories behind it are deleted.
model UserBadge {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Key of a definition in badges.config.ts. A plain string, not an enum,
  // so the config stays the single source of truth for the catalog.
  badgeKey String
  tier     BadgeTier
  earnedAt DateTime  @default(now())

  favorites FavoriteBadge[]

  // Each tier is earned (and its XP awarded) at most once per account.
  // Also serves "all badges of a user" through its leading userId column.
  @@unique([userId, badgeKey, tier])
  // Lets FavoriteBadge point at (id, userId) together, so the database
  // itself refuses a showcase entry with somebody else's badge.
  @@unique([id, userId])
  @@map("user_badges")
}

// The profile showcase: up to three earned badges, one per slot. The slot is
// 0, 1 or 2; a CHECK constraint added by hand in the migration enforces it,
// as Prisma has no syntax for CHECK.
model FavoriteBadge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot        Int
  userBadgeId String
  // Composite, not just userBadgeId: the badge must belong to this user.
  userBadge   UserBadge @relation(fields: [userBadgeId, userId], references: [id, userId], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, slot])
  // The same earned badge cannot fill two slots.
  @@unique([userBadgeId])
  @@map("favorite_badges")
}

// Periods a cycle's tasks can be completed in; a subset of TaskType.
enum CycleType {
  DAILY
  WEEKLY
}

// A period in which every due top-level task of the cycle was completed,
// recorded at the moment the last one was checked. Never removed: unchecking
// or deleting tasks later does not rewrite history.
model CompletedPeriod {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleType   CycleType
  // Same format as TaskCompletion.periodKey. Zero-padded, so sorting the
  // strings sorts the periods in time order.
  periodKey   String
  completedAt DateTime  @default(now())

  // One row per period. The same index answers the streak query
  // (userId, cycleType = ? ORDER BY periodKey DESC LIMIT n) without a sort.
  @@unique([userId, cycleType, periodKey])
  @@map("completed_periods")
}

// A "days without X" goal. Its current attempt lives in this row: it runs
// from startedAt until now. Times are instants set by the server, so time
// zones and daylight saving do not change how long an attempt is.
//
// The name can reveal health matters and is stored unencrypted, a known
// limit: it is private to the user and must never be logged.
model StreakGoal {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  startedAt    DateTime        @db.Timestamptz(3)
  // How many full days of the current attempt have been paid in XP. Stored,
  // although days can be derived from startedAt, because it records a
  // payment: the guard against paying the same day twice.
  daysRewarded Int             @default(0)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  attempts     StreakAttempt[]

  @@index([userId])
  @@map("streak_goals")
}

// A closed attempt of a goal, written when the user slips. Deleted with the
// goal; badges and XP are separate rows, so they stay.
model StreakAttempt {
  id          String     @id @default(uuid())
  goalId      String
  goal        StreakGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  startedAt   DateTime   @db.Timestamptz(3)
  endedAt     DateTime   @db.Timestamptz(3)
  durationSec Int

  // Postgres does not index foreign keys on its own; the record and slip
  // counts are grouped by this column.
  @@index([goalId])
  @@map("streak_attempts")
}