# Połączenie z bazą: te same wartości co w pliku .env w katalogu głównym.
# Budowa adresu: postgresql://DB_USER:DB_PASSWORD@localhost:DB_PORT/DB_NAME
# (DB_PORT bez zmian to 5432). Testy e2e biorą ten adres, zamieniają w nim
# nazwę bazy na pandaquest_test i same ją zakładają: tej bazy nie ruszają.
DATABASE_URL=postgresql://pandaquest:zmien-to-haslo@localhost:5432/pandaquest

# Sekret podpisujący tokeny JWT. Bez niego backend się nie uruchomi.
# Długi losowy ciąg wygeneruje komenda:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=zmien-to-na-dlugi-losowy-ciag

# Port serwera. Bez tego wpisu backend używa portu 3000.
# PORT=3000
