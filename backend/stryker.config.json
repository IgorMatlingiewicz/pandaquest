{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/jest-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "enableFindRelatedTests": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "coverageAnalysis": "perTest",
  "timeoutMS": 15000,
  "ignorePatterns": [
    "/*",
    "!/src",
    "!/prisma",
    "/prisma/*",
    "!/prisma/migrations",
    "!/package.json",
    "!/tsconfig*.json"
  ],
  "mutate": [
    "src/badges/badges.logic.ts",
    "src/common/full-period.ts",
    "src/common/user-throttler.guard.ts",
    "src/streak-goals/streak-goals.logic.ts",
    "src/stats/stats.logic.ts",
    "src/profile/profile.logic.ts",
    "src/friends/friend-code.ts",
    "src/friends/friend-errors.ts",
    "src/friends/friend-requests.logic.ts",
    "src/friends/friend-views.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "thresholds": { "high": 90, "low": 75, "break": 75 }
}
