# Adres backendu, z którym łączy się aplikacja.
# W przeglądarce na tym samym komputerze wystarczy localhost:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Na telefonie (Expo Go) "localhost" oznacza sam telefon, więc wpisz adres
# tego komputera w sieci lokalnej. Windows: komenda ipconfig, wiersz
# "Adres IPv4" karty Wi-Fi; macOS/Linux: ipconfig getifaddr en0 / hostname -I.
# Telefon i komputer muszą być w tej samej sieci Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Po każdej zmianie tego pliku uruchom Expo od nowa z czyszczeniem pamięci
# (pnpm start -c): adres jest wpisywany w aplikację przy jej budowaniu.
