# Dane bazy PostgreSQL dla docker-compose.yml. Skopiuj ten plik jako .env
# i ustaw własne hasło. Te same wartości wpisz w backend/.env (DATABASE_URL).
DB_USER=pandaquest
DB_PASSWORD=zmien-to-haslo
DB_NAME=pandaquest

# Port bazy na tym komputerze. Bez tego wpisu: 5432. Zmień, jeśli 5432 zajmuje
# już inny Postgres, i wpisz ten sam port w DATABASE_URL w backend/.env.
# DB_PORT=5433
